# Copy to keystore.properties (gitignored, repo root) and fill in real values,
# OR skip this file entirely and set the equivalent MQ_KEYSTORE_* / MQ_KEY_*
# env vars instead (env vars take precedence over this file).
#
# Without either, `./gradlew assembleRelease` falls back to debug signing.

storeFile=/absolute/path/to/mupenquest-release.jks
storePassword=changeit
keyAlias=mupenquest
keyPassword=changeit
