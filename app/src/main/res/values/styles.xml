<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="appTheme" parent="@android:style/Theme.Holo">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="Theme.AppCompat.Black">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:navigationBarColor">@color/mupen_black</item>
    </style>

    <style name="Theme.AppCompat.Black.OverlayActionBar">
        <item name="windowActionBarOverlay">true</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:navigationBarColor">@color/mupen_black</item>
    </style>

    <style name="btnMappable" parent="@android:style/Widget.Button">
        <item name="android:layout_width">@dimen/inputMapPreferenceButtonSize</item>
        <item name="android:layout_height">@dimen/inputMapPreferenceButtonSize</item>
        <item name="android:background">@drawable/button_gray</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:textColor">@android:color/primary_text_dark_nodisable</item>
    </style>

    <style name="btnMappableNoText" parent="@style/btnMappable">
        <item name="android:textColor">@android:color/transparent</item>
    </style>

    <style name="btnSpecialMappable" parent="@style/btnMappable">
        <item name="android:layout_width">@dimen/inputMapPreferenceButtonSizeX3</item>
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
    </style>

    <style name="alertDialogMessage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
    </style>

    <!-- Dark (default) Theme Styles -->
    <style name="MupenTheme_Dark.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">@string/default_font</item>
        <item name="android:navigationBarColor">@color/mupen_black</item>
        <item name="android:textSize">@dimen/quest_text_base</item>
        <item name="android:statusBarColor">@color/mupen_black</item>
        <!-- Quest design system: slab ground, accent, VR type sizes and 72dp ray targets -->
        <item name="android:windowBackground">@color/quest_slab_ground</item>
        <item name="android:colorBackground">@color/quest_slab_ground</item>
        <item name="colorPrimary">@color/quest_slab_ground</item>
        <item name="colorPrimaryDark">@color/quest_slab_ground</item>
        <item name="colorAccent">@color/quest_accent</item>
        <item name="android:textColorPrimary">@color/quest_text_primary</item>
        <item name="android:textColorSecondary">@color/quest_text_secondary</item>
        <item name="textAppearanceListItem">@style/QuestListItem</item>
        <item name="textAppearanceListItemSecondary">@style/QuestListItemSecondary</item>
        <item name="android:textAppearanceListItem">@style/QuestListItem</item>
        <item name="android:textAppearanceListItemSecondary">@style/QuestListItemSecondary</item>
        <item name="listPreferredItemHeight">@dimen/quest_hit_comfort</item>
        <item name="listPreferredItemHeightSmall">@dimen/quest_hit_comfort</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/quest_hit_comfort</item>
        <item name="toolbarStyle">@style/QuestToolbar</item>
    </style>

    <style name="MupenTheme_Dark" parent="Theme.AppCompat">
        <item name="android:fontFamily">@string/default_font</item>
        <item name="android:navigationBarColor">@color/mupen_black</item>
        <item name="android:textSize">@dimen/quest_text_base</item>
        <item name="android:statusBarColor">@color/mupen_black</item>
        <!-- Quest design system: slab ground, accent, VR type sizes and 72dp ray targets -->
        <item name="android:windowBackground">@color/quest_slab_ground</item>
        <item name="android:colorBackground">@color/quest_slab_ground</item>
        <item name="colorPrimary">@color/quest_slab_ground</item>
        <item name="colorPrimaryDark">@color/quest_slab_ground</item>
        <item name="colorAccent">@color/quest_accent</item>
        <item name="android:textColorPrimary">@color/quest_text_primary</item>
        <item name="android:textColorSecondary">@color/quest_text_secondary</item>
        <item name="textAppearanceListItem">@style/QuestListItem</item>
        <item name="textAppearanceListItemSecondary">@style/QuestListItemSecondary</item>
        <item name="android:textAppearanceListItem">@style/QuestListItem</item>
        <item name="android:textAppearanceListItemSecondary">@style/QuestListItemSecondary</item>
        <item name="listPreferredItemHeight">@dimen/quest_hit_comfort</item>
        <item name="listPreferredItemHeightSmall">@dimen/quest_hit_comfort</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/quest_hit_comfort</item>
        <item name="toolbarStyle">@style/QuestToolbar</item>
        <item name="actionBarStyle">@style/QuestActionBar</item>
        <item name="actionBarSize">88dp</item>
    </style>

    <style name="MupenTheme_Dark_Sidebar" parent="MupenTheme_Dark">
        <item name="android:background">@color/mupen_black</item>
        <item name="android:textColor">@color/mupen_white</item>
        <item name="android:listChoiceBackgroundIndicator">@color/mupen_primary</item>
        <item name="android:divider">@drawable/divider_parent</item>
        <item name="android:childDivider">@drawable/divider_menu</item>
        <item name="android:scrollbars">none</item>
    </style>

    <style name="Theme.Mupen64plusaeTheme" parent="MupenTheme_Dark">
    </style>

    <style name="Theme.Mupen64plusaeTheme.NoActionBar" parent="MupenTheme_Dark.NoActionBar">
    </style>

    <style name="Theme.Mupen64plusaeTheme.Game" parent="@style/Theme.AppCompat.Black">
    </style>

</resources>
