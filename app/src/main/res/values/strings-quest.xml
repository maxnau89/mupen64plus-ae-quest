    <string name="stereo3d_title">Stereoscopic 3D (experimental)</string>
    <string name="stereo3d_summary">Render the scene once per eye. Needs the GLideN64 video plug-in, which it selects on its own. Unfinished, expect glitches.</string>
    <string name="stereo3dMode_title">Eye</string>
    <string name="stereo3dMode_default" translatable="false">0</string>
    <string name="stereo3dMode_entryOff">Off</string>
    <string name="stereo3dMode_entryLeft">Left eye</string>
    <string name="stereo3dMode_entryRight">Right eye</string>
    <string name="stereo3dSeparation_title">Eye separation</string>
    <string name="stereo3dSeparation_summary">How far the eye moves aside. 30 matches a 2 m screen at 2 m distance.</string>
    <string name="stereo3dConvergence_title">Convergence depth</string>
    <string name="stereo3dConvergence_summary">Depth that stays on the screen plane, in the game’s own units. 0 measures it from the scene automatically.</string>
    <string name="stereo3dFov_title">3D field of view</string>
    <string name="stereo3dFov_summary">Widens the game camera without stretching the picture. High values can reveal missing geometry at the edges.</string>
    <string name="stereo3dMode_entryBoth">Both eyes (double pass)</string>
    <string name="quest_game_stereo_title">3D (experimental)</string>
    <string name="quest_game_stereo_on">On: each eye gets its own view. Starts with the GLideN64 video plug-in. Tap for immersive.</string>
    <string name="quest_game_stereo_off">Off. Tap to give this game depth in the headset.</string>
    <string name="quest_game_stereo_tuning">Tuning a single eye, set in the game’s settings. Tap to switch off.</string>
    <string name="stereo3dImmersive_title">Immersive</string>
    <string name="stereo3dImmersiveHeight_title">Immersive resolution per eye</string>
    <string name="stereo3dImmersiveWorld_title">Immersive world size</string>
    <string name="stereo3dImmersiveWorld_summary">Shows the scene at a smaller angle, as if the game\'s camera had a narrower view. Head turns still match. Below 100% the picture no longer fills the whole view.</string>
    <string name="stereo3dImmersiveSharp_title">Sharper small textures</string>
    <string name="stereo3dImmersiveSharp_summary">Upscales small textures with xBRZ, for HUD fonts that fall apart when spread over the whole view. Costs memory and some speed, and changes the look.</string>
    <string name="stereo3dImmersiveHud_title">Immersive HUD size</string>
    <string name="stereo3dImmersiveHud_summary">How wide the HUD is spread. At 100% it spans as much of your view as the game\'s own camera, which can push it into the corners of your eye.</string>
    <string name="stereo3dImmersiveDistance_title">Immersive camera distance</string>
    <string name="stereo3dImmersiveDistance_summary">Moves the camera back, for games whose camera sits very close, like racing games. 100% doubles the distance to the nearest object. Things right behind the old camera may be missing.</string>
    <string name="stereo3dImmersive_summary">Instead of a screen, the game fills your view and turning your head turns the camera. Parts of the world the game did not expect to be seen may be missing at the sides.</string>
    <string name="quest_game_stereo_immersive">Immersive: the game fills your view and follows your head. Tap to switch off.</string>
    <string name="stereo3dDepthBoost_title">Depth boost</string>
    <string name="stereo3dDepthBoost_summary">Spreads a deep scene in depth, for racing games whose track otherwise sits almost at the horizon. 0% is physically correct.</string>
