<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="QuestButton">
        <item name="android:minHeight">@dimen/quest_hit_comfort</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/quest_text_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/quest_hover_lift</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="QuestButton.Accent">
        <item name="android:background">@drawable/quest_button_accent</item>
        <item name="android:textColor">#06201F</item>
    </style>

    <style name="QuestButton.Secondary">
        <item name="android:background">@drawable/quest_button_secondary</item>
        <item name="android:textColor">@color/quest_text_primary</item>
    </style>

    <style name="QuestRowTitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/quest_text_base</item>
        <item name="android:textColor">@color/quest_text_primary</item>
    </style>
</resources>
