<?xml version="1.0" encoding="utf-8"?>
<!-- Section inside the slab: two columns of category tiles, one level deep -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/questSection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:background="@color/quest_slab_fill"
    android:clipToPadding="false"
    android:padding="@dimen/quest_slab_inset"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/questSectionTiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</ScrollView>
