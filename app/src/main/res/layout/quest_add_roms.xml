<?xml version="1.0" encoding="utf-8"?>
<!-- Add ROMs section inside the library slab (ui_kits/quest_vr, PreferenceRow + Panel) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/questAddRoms"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:background="@color/quest_slab_fill"
    android:clipToPadding="false"
    android:padding="@dimen/quest_slab_inset"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textNoSafSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/quest_gap_min"
            android:visibility="gone"
            style="@style/QuestRowTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="@drawable/quest_divider"
            android:showDividers="middle"
            android:background="@drawable/quest_panel_raised"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/buttonFolderPicker"
                style="@style/QuestScanRow">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    android:alpha="0.92"
                    android:src="@drawable/ic_folder"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scanRomsDialog_select_folder"
                        style="@style/QuestRowTitle" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quest_scan_folderSummary"
                        style="@style/QuestSubtitle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonFilePicker"
                style="@style/QuestScanRow">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    android:alpha="0.92"
                    android:src="@drawable/ic_box"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scanRomsDialog_select_file"
                        style="@style/QuestRowTitle" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quest_scan_fileSummary"
                        style="@style/QuestSubtitle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonEnterPath"
                style="@style/QuestScanRow">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    android:alpha="0.92"
                    android:src="@drawable/ic_pencil"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scanRomsDialog_enter_path"
                        style="@style/QuestRowTitle" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quest_scan_pathSummary"
                        style="@style/QuestSubtitle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="@dimen/quest_gap_min"
            android:text="@string/quest_scan_optionsTitle"
            style="@style/QuestSectionLabel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="@drawable/quest_divider"
            android:showDividers="middle"
            android:background="@drawable/quest_panel_raised"
            android:elevation="8dp">

            <CheckBox
                android:id="@+id/checkBox1"
                android:text="@string/scanRomsDialog_searchZips"
                style="@style/QuestScanCheck" />

            <CheckBox
                android:id="@+id/checkBox4"
                android:text="@string/scanRomsDialog_scanSubdirectories"
                style="@style/QuestScanCheck" />

            <CheckBox
                android:id="@+id/checkBox2"
                android:text="@string/scanRomsDialog_downloadArt"
                style="@style/QuestScanCheck" />

            <CheckBox
                android:id="@+id/checkBox3"
                android:text="@string/scanRomsDialog_clearGallery"
                style="@style/QuestScanCheck" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
