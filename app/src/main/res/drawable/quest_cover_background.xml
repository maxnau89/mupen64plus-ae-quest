<?xml version="1.0" encoding="utf-8"?>
<!-- Cover tile: accent ring when hovered or focused by the ray -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="180">
    <item android:state_hovered="true"><shape><solid android:color="@color/quest_panel_fill_raised" /><stroke android:width="2dp" android:color="@color/quest_accent" /><corners android:radius="4dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/quest_panel_fill_raised" /><stroke android:width="2dp" android:color="@color/quest_accent" /><corners android:radius="4dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/quest_surface_hover" /><corners android:radius="4dp" /></shape></item>
    <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="4dp" /></shape></item>
</selector>
