<?xml version="1.0" encoding="utf-8"?>
<!-- CategoryTile: panel fill with a hairline edge; accent edge on the raised fill when hovered -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_pressed="true"><shape><solid android:color="@color/quest_panel_fill_raised" /><stroke android:width="1dp" android:color="@color/quest_accent" /><corners android:radius="4dp" /></shape></item>
    <item android:state_hovered="true"><shape><solid android:color="@color/quest_panel_fill_raised" /><stroke android:width="1dp" android:color="@color/quest_accent" /><corners android:radius="4dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/quest_panel_fill_raised" /><stroke android:width="1dp" android:color="@color/quest_accent" /><corners android:radius="4dp" /></shape></item>
    <item><shape><solid android:color="@color/quest_panel_fill" /><stroke android:width="1dp" android:color="@color/quest_slab_edge" /><corners android:radius="4dp" /></shape></item>
</selector>
